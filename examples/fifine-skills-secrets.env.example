# Copy to ~/.config/fifine-skills/secrets.env on your own machine.
# This example is safe to commit because it contains placeholders only.

# fifine-trans-criptase semantic/hybrid embedding
TRANS_EMBED_PROVIDER=api
TRANS_EMBED_BASE_URL=https://your-openai-compatible-embedding-endpoint/v1
TRANS_EMBED_API_KEY=your-embedding-api-key
TRANS_EMBED_MODEL=BAAI/bge-m3
TRANS_RERANK_MODEL=BAAI/bge-reranker-v2-m3

# fifine-paddleocr-vl AI Studio API
PADDLEOCR_AISTUDIO_TOKEN=your-ai-studio-token
PADDLEOCR_MODEL=PaddleOCR-VL-1.6
